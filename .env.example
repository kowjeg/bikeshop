# Скопируйте в .env:  cp .env.example .env
# Значения без символов $ и # — docker compose их интерпретирует.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
# Для prod: DJANGO_SETTINGS_MODULE=config.settings.prod и DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

POSTGRES_DB=bikeshop
POSTGRES_USER=bikeshop
POSTGRES_PASSWORD=bikeshop
# db — имя сервиса в docker-compose. Для запуска pytest с хоста: POSTGRES_HOST=localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
